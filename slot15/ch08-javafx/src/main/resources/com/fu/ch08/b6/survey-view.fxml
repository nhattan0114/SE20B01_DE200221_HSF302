<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fu.ch08.b6.SurveyController"
            fitToWidth="true" prefWidth="650" prefHeight="700">
    <content>
        <VBox spacing="14">
            <padding>
                <Insets top="16" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="PHIẾU KHẢO SÁT SINH VIÊN (HSF302)"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a73e8;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Tiến độ hoàn thành:"/>
                <ProgressBar fx:id="pbComplete" prefWidth="250" progress="0.0"/>
            </HBox>

            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="130" prefWidth="140"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- MSSV -->
                <Label text="MSSV (*):" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="tfStudentId" promptText="SE123456" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <!-- Họ tên -->
                <Label text="Họ tên (*):" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="tfFullName" promptText="Nguyễn Văn A" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Ngành -->
                <Label text="Ngành (*):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ChoiceBox fx:id="cbMajor" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <!-- Kỳ học -->
                <Label text="Kỳ học:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <Spinner fx:id="spSemester" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Giới tính -->
                <Label text="Giới tính (*):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <HBox spacing="20" alignment="CENTER_LEFT" GridPane.rowIndex="4" GridPane.columnIndex="1">
                    <fx:define>
                        <ToggleGroup fx:id="tgGender"/>
                    </fx:define>
                    <RadioButton text="Nam" toggleGroup="$tgGender"/>
                    <RadioButton text="Nữ" toggleGroup="$tgGender"/>
                    <RadioButton text="Khác" toggleGroup="$tgGender"/>
                </HBox>

                <!-- Ngày khảo sát -->
                <Label text="Ngày khảo sát (*):" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpDate" maxWidth="Infinity" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Mức hài lòng -->
                <Label text="Mức hài lòng (1-5):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <VBox spacing="4" GridPane.rowIndex="6" GridPane.columnIndex="1">
                    <Slider fx:id="slSatisfaction"/>
                    <Label fx:id="lblSatisfaction" style="-fx-text-fill: #0d47a1; -fx-font-weight: bold;"/>
                </VBox>

                <!-- Phần thích nhất -->
                <Label text="Phần thích nhất (*):" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <FlowPane hgap="14" vgap="6" GridPane.rowIndex="7" GridPane.columnIndex="1">
                    <CheckBox fx:id="chkSpring" text="Spring"/>
                    <CheckBox fx:id="chkJpa" text="JPA"/>
                    <CheckBox fx:id="chkFx" text="JavaFX"/>
                    <CheckBox fx:id="chkTesting" text="Testing"/>
                </FlowPane>

                <!-- Màu yêu thích -->
                <Label text="Màu giao diện thích:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                <ColorPicker fx:id="cpColor" GridPane.rowIndex="8" GridPane.columnIndex="1"/>

                <!-- Ngôn ngữ -->
                <Label text="Ngôn ngữ đã biết:" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                <VBox spacing="6" GridPane.rowIndex="9" GridPane.columnIndex="1">
                    <HBox spacing="8">
                        <ComboBox fx:id="cbLanguage" promptText="Chọn hoặc gõ ngôn ngữ" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Thêm" onAction="#handleAddLanguage"/>
                    </HBox>
                    <ListView fx:id="lvLanguages" prefHeight="90"/>
                </VBox>

                <!-- Góp ý -->
                <Label text="Góp ý (≤ 300 ký tự):" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                <VBox spacing="4" GridPane.rowIndex="10" GridPane.columnIndex="1">
                    <TextArea fx:id="taComment" prefRowCount="3" wrapText="true"/>
                    <Label fx:id="lblCharCount" text="0/300" style="-fx-font-size: 11px; -fx-text-fill: gray;"/>
                </VBox>
            </GridPane>

            <!-- Buttons -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Hyperlink text="Xem đề cương môn học" onAction="#handleSyllabus"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Làm lại" onAction="#handleReset"/>
                <Button text="Gửi khảo sát" defaultButton="true" onAction="#handleSubmit"
                        style="-fx-background-color: #1a73e8; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
